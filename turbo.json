{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
        "env": [
          "NEXTAUTH_URL",
          "NEXTAUTH_SECRET",
          "FIREBASE_PROJECT_ID",
          "FIREBASE_PRIVATE_KEY_ID",
          "FIREBASE_PRIVATE_KEY",
          "FIREBASE_CLIENT_EMAIL",
          "FIREBASE_CLIENT_ID",
          "FIREBASE_CLIENT_X509_CERT_URL",
          "FIREBASE_PROJECT_URL",
          "STRIPE_API_KEY",
          "STRIPE_CLIENT_ID",
          "STRIPE_OAUTH_REDIRECT_URI",
          "STRIPE_OAUTH_API_KEY",
          "STRIPE_SUBSCRIBE_WEBHOOK_SECRET",
          "STRIPE_UNSUBSCRIBE_WEBHOOK_SECRET",
          "ENCRYPTION_KEY"
        ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
